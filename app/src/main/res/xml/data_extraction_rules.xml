<?xml version="1.0" encoding="utf-8"?>
<!--
    Pause stores everything locally and disables cloud backup on purpose.
    These rules are a second line of defence: no settings or history are ever
    uploaded or transferred off the device by the platform.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
