<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        A deliberately bare platform theme: all UI is Compose. The only job of
        these themes is to set a matching window background before the first
        frame and to let the app draw edge-to-edge without an action bar.
    -->
    <style name="Theme.Pause" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pause_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The intervention surface is intentionally dark in light and dark mode. -->
    <style name="Theme.Pause.Intervention" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pause_intervention_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
