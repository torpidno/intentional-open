    <string name="permission_accessibility_body">Accessibility lets Pause notice when a monitored app opens. It listens only for window changes and never reads screen content.</string>
    <string name="permission_overlay_title">Display over other apps</string>
    <string name="permission_overlay_body">Lets Pause draw its pause screen and the gentle session-end reminder over the app you opened.</string>
    <string name="permission_battery_title">Battery optimisation</string>
    <string name="permission_battery_body">Exempting Pause keeps the service awake so the pause is there when you need it. It uses negligible battery when idle.</string>
    <string name="permission_notifications_title">Session reminders</string>
    <string name="permission_notifications_body">A local notification lets Pause remind you when a session ends, even if Android closed the app. It uses no internet.</string>
