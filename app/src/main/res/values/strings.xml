    <!-- Accessibility service -->
    <string name="accessibility_service_label">Pause app opener</string>
    <string name="accessibility_service_summary">Notices when a monitored app opens</string>
    <string name="accessibility_service_description">Pause adds a short, private pause before the apps you choose can open.\n\nIt only listens for window changes so it can tell which app came to the foreground. It never reads what is on your screen, never records typing, and has no internet permission. Everything stays on this device.</string>

