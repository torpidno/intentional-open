<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Pause is intentionally offline-first:
        * There is NO android.permission.INTERNET anywhere in this project.
        * There are no analytics, crash-reporting or ads SDKs.
        * All settings and history live on-device (DataStore + Room).
    -->

    <!-- Required to draw the "session time is up" reminder over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required to send the user to the battery-optimization exemption prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Session-end reminders are local notifications; no network is involved. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arm an active session reminder after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Optional: reads local daily foreground app time for daily app budgets. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Package visibility for the app picker + the launcher detection used by
        the accessibility service. This is the narrow, Play-policy friendly way
        to see launchable apps; QUERY_ALL_PACKAGES is deliberately NOT used.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".PauseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pause"
        tools:targetApi="35">

        <!-- Main dashboard / configuration surface. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pause"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Full-screen friction surface. Started by the accessibility service.
            It is excluded from recents and lives in its own task so "back" and
            the system's "close" affordances behave like an overlay.
        -->
        <activity
            android:name=".ui.intervention.PauseInterventionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="com.pause.app.intervention"
            android:theme="@style/Theme.Pause.Intervention"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The only long-running component. It receives TYPE_WINDOW_STATE_CHANGED
            events, but its package filter is narrowed at runtime to the apps the
            user selected so idle wake-ups are effectively zero.
        -->
        <service
            android:name=".service.PauseAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Fires the durable session-end alarm even if the app process died. -->
        <receiver
            android:name=".service.SessionReminderReceiver"
            android:exported="false" />

        <!-- Reschedules an active session after reboot or an app update. -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
